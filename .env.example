# Public URL of the site, used for canonical links and the sitemap
NEXT_PUBLIC_SITE_URL=https://example.vercel.app

# Optional: hosted booking engine (FleetWire or similar). When set, "Book" buttons
# send guests to this URL instead of the built-in request-to-book form.
NEXT_PUBLIC_BOOKING_ENGINE_URL=

# Optional: email booking requests to the owner via Resend
RESEND_API_KEY=
BOOKING_NOTIFY_EMAIL=
BOOKING_FROM_EMAIL=
